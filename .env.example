# Copy to .env.local for local development, or set these in
# Netlify → Site settings → Environment variables for the live site.
#
# The site works with none of these set. Each one switches on an optional
# extra, and anything unset is simply left out of the build.

# Cookieless Plausible analytics. Set this to the live domain to switch it on.
# No cookies are used, so no consent banner is required.
# Leave unset and no analytics script is included at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
